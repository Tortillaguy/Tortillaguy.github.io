---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import MainLayout from "../layouts/MainLayout.astro";
import heroImage from "../assets/hero.jpg";
---

<!doctype html>
<html lang="en" class="bg-encore-bg">
  <head>
    <BaseHead title="Adrian Cacho – Lab" description="HTML-in-canvas experiments." />
    <meta name="robots" content="noindex" />
  </head>

  <MainLayout>
    <section
      id="lab-hero"
      class="relative h-[calc(100svh-52px)] md:h-[calc(100svh-76px)] min-h-[600px] max-h-[1100px] overflow-hidden"
    >
      <Image
        src={heroImage}
        alt="Festival stage under light beams with crowd silhouettes"
        class="absolute inset-0 w-full h-full object-cover"
        widths={[390, 800, 1440, 2400]}
        sizes="100vw"
        loading="eager"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(10,10,10,0) 35%, rgba(10,10,10,0.8) 80%, #0A0A0A 100%);"
      >
      </div>

      <div id="type-layer" class="absolute inset-0 w-full h-full flex flex-col justify-between">
        <div class="h-11 md:h-16"></div>
        <div class="px-5 md:px-12 font-grotesk font-medium leading-[0.95] text-[36px] md:text-[64px]">
          <p class="fringe-sm md:fringe text-encore-fg m-0">LIGHT,</p>
          <p class="fringe-sm md:fringe text-encore-fg m-0">MOTION,</p>
          <p class="text-encore-accent m-0">&amp; CODE.</p>
        </div>
        <h1 class="font-display text-encore-fg leading-[0.82] m-0 px-5 pb-7 text-[96px] sm:hidden">
          ADRIAN<br />CACHO
        </h1>
        <h1 class="hidden sm:block font-display text-encore-fg leading-[0.82] m-0 text-center text-[clamp(96px,18vw,265px)] whitespace-nowrap">
          ADRIAN CACHO
        </h1>
      </div>
    </section>

    <section class="px-5 md:px-12 py-12 max-w-[720px] font-smono text-encore-dim text-[12px] tracking-[1px] leading-relaxed">
      <p id="lab-status" class="m-0">CHECKING FOR HTML-IN-CANVAS…</p>
      <p class="m-0 pt-3">
        The type above is real, selectable HTML. In browsers with HTML-in-canvas it is drawn into a WebGL
        texture, and the cyan/magenta fringe is computed per pixel in a shader instead of a CSS text-shadow:
        it widens around the cursor and when you scroll. Elsewhere it falls back to the CSS version.
      </p>
    </section>
  </MainLayout>
</html>

<script>
  const FRAG = `#version 300 es
precision highp float;
in vec2 vUv;
out vec4 outColor;
uniform sampler2D uTex;
uniform vec2 uRes;      // canvas size in device px
uniform vec2 uPointer;  // pointer in uv, y up
uniform float uBase;    // base fringe, device px
uniform float uBoost;   // velocity-driven extra fringe, device px
uniform float uTime;
uniform float uGlitch;  // 0 under reduced motion

const vec3 CYAN = vec3(0.31, 0.89, 1.0);
const vec3 MAGENTA = vec3(1.0, 0.29, 0.85);

float hash(float n) { return fract(sin(n) * 43758.5453); }

void main() {
  vec2 toPointer = (vUv - uPointer) * vec2(uRes.x / uRes.y, 1.0);
  float near = exp(-dot(toPointer, toPointer) * 18.0);
  float band = step(0.992, hash(floor(vUv.y * 48.0) * 91.7 + floor(uTime * 10.0))) * uGlitch;
  float px = uBase + uBoost + near * 10.0 + band * 14.0;
  vec2 d = vec2(px / uRes.x, 0.0);

  vec4 c = texture(uTex, vUv);
  float left = texture(uTex, vUv + d).a;
  float right = texture(uTex, vUv - d).a;
  float fl = max(left - c.a, 0.0) * 0.5;
  float fr = max(right - c.a, 0.0) * 0.5;
  outColor = vec4(c.rgb + CYAN * fl + MAGENTA * fr, clamp(c.a + fl + fr, 0.0, 1.0));
}`;

  const VERT = `#version 300 es
in vec2 aPos;
out vec2 vUv;
void main() { vUv = aPos * 0.5 + 0.5; gl_Position = vec4(aPos, 0.0, 1.0); }`;

  const status = document.getElementById("lab-status")!;
  const section = document.getElementById("lab-hero")!;
  const layer = document.getElementById("type-layer")!;
  const supported =
    "drawElementImage" in CanvasRenderingContext2D.prototype &&
    "texElementSubImage2D" in WebGL2RenderingContext.prototype;

  if (!supported) {
    status.textContent = "FALLBACK: NO HTML-IN-CANVAS IN THIS BROWSER, SHOWING THE CSS FRINGE.";
  } else {
    enhance();
  }

  function compile(gl: WebGL2RenderingContext, type: number, src: string) {
    const s = gl.createShader(type)!;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? "shader");
    return s;
  }

  function enhance() {
    const canvas = document.createElement("canvas") as HTMLCanvasElement & Record<string, any>;
    canvas.className = "absolute inset-0 w-full h-full";
    canvas.setAttribute("content", "drawable");
    canvas.setAttribute("layoutsubtree", "");
    const gl = canvas.getContext("webgl2", { premultipliedAlpha: true }) as WebGL2RenderingContext & Record<string, any>;
    if (!gl) return;

    for (const el of layer.querySelectorAll(".fringe-sm")) el.classList.remove("fringe-sm", "md:fringe");
    layer.classList.remove("absolute", "inset-0");
    layer.setAttribute("drawable", "");
    section.appendChild(canvas);
    canvas.appendChild(layer);

    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl, gl.VERTEX_SHADER, VERT));
    gl.attachShader(program, compile(gl, gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(program);
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(program, "aPos");
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
    gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);

    const u = (name: string) => gl.getUniformLocation(program, name);
    const uRes = u("uRes"), uPointer = u("uPointer"), uBase = u("uBase");
    const uBoost = u("uBoost"), uTime = u("uTime"), uGlitch = u("uGlitch");
    gl.uniform1i(u("uTex"), 0);

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const pointer = { x: -10, y: -10 };
    let boost = 0;
    let lastY = window.scrollY;
    let visible = true;

    section.addEventListener("pointermove", (e) => {
      const r = section.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width;
      const ny = 1 - (e.clientY - r.top) / r.height;
      if (!reduced.matches) boost = Math.min(boost + Math.hypot(nx - pointer.x, ny - pointer.y) * 40, 12);
      pointer.x = nx;
      pointer.y = ny;
    });
    section.addEventListener("pointerleave", () => { pointer.x = pointer.y = -10; });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) canvas.requestPaint();
    }).observe(section);
    new ResizeObserver(([entry]) => {
      canvas.width = entry.devicePixelContentBoxSize[0].inlineSize;
      canvas.height = entry.devicePixelContentBoxSize[0].blockSize;
      canvas.requestPaint();
    }).observe(canvas, { box: "device-pixel-content-box" });

    canvas.onpaint = (event: Event & { changedElements?: Element[] }) => {
      if (Array.from(event.changedElements ?? []).includes(layer)) {
        const { width, height } = canvas.getElementImageDefaultSize(layer);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, width, height, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
        gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, layer);
        canvas.updateElementGeometry(layer, { canvasTransform: new DOMMatrix() });
      }

      const dy = Math.abs(window.scrollY - lastY);
      lastY = window.scrollY;
      if (!reduced.matches) boost = Math.min(boost + dy * 0.15, 12);
      boost *= 0.9;

      const dpr = window.devicePixelRatio || 1;
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform2f(uPointer, reduced.matches ? -10 : pointer.x, pointer.y);
      gl.uniform1f(uBase, (window.innerWidth >= 768 ? 2 : 1) * dpr);
      gl.uniform1f(uBoost, boost * dpr);
      gl.uniform1f(uTime, performance.now() / 1000);
      gl.uniform1f(uGlitch, reduced.matches ? 0 : 1);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      if (visible && !reduced.matches) canvas.requestPaint();
    };
    canvas.requestPaint();
    status.textContent = "HTML-IN-CANVAS ACTIVE: TYPE IS DRAWN THROUGH A WEBGL SHADER.";
  }
</script>
