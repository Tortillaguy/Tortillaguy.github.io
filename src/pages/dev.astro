---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import SectionHeader from "../components/SectionHeader.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Engineering from "../sections/Engineering.astro";
import offers from "../data/offers";
import heroImage from "../assets/hero.jpg";
import { ClientRouter } from "astro:transitions";

const steps = [
  ["INTRO CALL", "A short call about your system, your team and the problem. If it isn't a fit, I'll say so."],
  ["FIXED-SCOPE PROPOSAL", "A written scope with deliverables, timeline and one fixed price. Anything outside it is quoted separately."],
  ["BUILD + HAND-OFF", "I build it in your repos and on your infrastructure, then hand off with docs your engineers can extend."],
];
---

<!doctype html>
<html lang="en" class="bg-encore-bg">
  <head>
    <BaseHead
      title={"Adrian Cacho – AI & Full-Stack Engineering"}
      description={"Staff-level full-stack and AI engineer. Agentic AI, MCP servers, agent evals, Claude Code rollouts for engineering teams, and video-AI ingestion and retrieval pipelines. Consulting through Vibe Labs."}
      image="/assets/og-dev.png"
    />
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Vibe Labs",
      "url": "https://cacho.dev/dev",
      "email": "hello@cacho.dev",
      "image": "https://cacho.dev/assets/og-dev.png",
      "description": "AI and full-stack engineering consulting: MCP servers, agent evals, Claude Code rollouts for engineering teams, and video-AI ingestion and retrieval pipelines.",
      "areaServed": "US",
      "address": { "@type": "PostalAddress", "addressLocality": "Venice", "addressRegion": "CA", "addressCountry": "US" },
      "founder": { "@type": "Person", "name": "Adrian Cacho", "url": "https://cacho.dev" },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Engagements",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "MCP server for your company's data" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Claude Code rollout for your engineering team" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Evals for your AI agent" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Video-AI ingestion and retrieval pipeline" } }
        ]
      }
    }
    </script>
    <ClientRouter />
  </head>

  <MainLayout>
    <section
      id="home"
      class="relative flex flex-col justify-end gap-10 md:gap-14 min-h-[560px] h-[calc(85svh-52px)] md:h-[calc(85svh-76px)] max-h-[900px] overflow-hidden pb-10 md:pb-14"
    >
      <Image
        src={heroImage}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover brightness-[0.18] grayscale"
        widths={[390, 800, 1440, 2400]}
        sizes="100vw"
        loading="eager"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(10,10,10,0) 30%, rgba(10,10,10,0.85) 80%, #0A0A0A 100%);"
      >
      </div>

      <div class="relative px-5 md:px-12 font-grotesk font-medium leading-[0.95] text-[36px] md:text-[64px]">
        <p class="fringe-sm md:fringe text-encore-fg m-0">AGENTS,</p>
        <p class="fuzzy-sm md:fuzzy text-encore-fg m-0">EVALS,</p>
        <p class="text-encore-accent m-0">&amp; CODE.</p>
      </div>

      <div class="relative px-5 md:px-12 md:flex md:items-end md:justify-between md:gap-12">
        <h1 class="font-display text-encore-fg leading-[0.82] m-0 text-[80px] sm:text-[clamp(96px,14vw,200px)] sm:whitespace-nowrap">
          ADRIAN<br class="sm:hidden" /> CACHO
        </h1>
        <p class="font-inter text-encore-dim text-sm md:text-base leading-[1.6] max-w-[380px] m-0 pt-6 md:pt-0 md:pb-3">
          Staff-level full-stack and AI engineer. I build agent tooling, evals and the apps around them.
          Consulting through Vibe Labs.
        </p>
      </div>
    </section>

    <section class="px-5 md:px-12 pt-16 md:pt-28">
      <SectionHeader id="offers" index="01" title="WHAT I BUILD" meta="FIXED SCOPE / REMOTE" />

      <div class="grid md:grid-cols-2 gap-px bg-encore-line border border-encore-line">
        {
          offers.map((offer, i) => (
            <article class="bg-encore-bg p-6 md:p-10 flex flex-col">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-smono text-encore-accent text-xs">{String(i + 1).padStart(2, "0")}</span>
                <span class="font-smono text-encore-accent text-xs tracking-[1px]">{offer.timeline}</span>
              </div>
              <h3 class="font-grotesk font-bold text-encore-fg text-xl md:text-2xl leading-tight m-0 pt-4">{offer.name}</h3>
              <p class="font-inter text-encore-dim text-sm leading-[1.6] m-0 pt-3">{offer.forWho}</p>
              <ul class="font-inter text-encore-fg text-sm leading-[1.6] m-0 pt-5 pl-0 list-none space-y-2">
                {offer.gets.map((g) => (
                  <li class="flex gap-3">
                    <span class="text-encore-accent shrink-0" aria-hidden="true">+</span>
                    <span>{g}</span>
                  </li>
                ))}
              </ul>
              <p class="font-inter text-encore-dim text-sm leading-[1.6] m-0 mt-auto pt-6">
                <span class="font-smono text-encore-accent text-xs tracking-[1px]">PROOF </span>
                {offer.proof}
              </p>
              {offer.href && (
                <a href={offer.href} class="font-smono text-encore-accent text-xs tracking-[1px] pt-4 hover:text-encore-fg transition-colors">
                  READ THE CASE STUDY →
                </a>
              )}
              <span class="font-smono text-encore-dim text-[10px] md:text-xs tracking-[1px] pt-4">{offer.tags.join(" / ")}</span>
            </article>
          ))
        }
      </div>
    </section>

    <Engineering id="work" index="02" title="WORK" />

    <section class="px-5 md:px-12 pt-16 md:pt-28">
      <SectionHeader id="process" index="03" title="HOW IT WORKS" />

      <ol class="grid md:grid-cols-3 gap-8 md:gap-12 list-none m-0 p-0">
        {
          steps.map(([title, body], i) => (
            <li class="border-t border-encore-line pt-6">
              <span class="font-smono text-encore-accent text-sm">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="font-grotesk font-bold text-encore-fg text-lg md:text-xl m-0 pt-3">{title}</h3>
              <p class="font-inter text-encore-dim text-sm md:text-base leading-[1.6] m-0 pt-3">{body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="px-5 md:px-12 pt-16 md:pt-32">
      <SectionHeader id="contact" index="04" title="SAY HELLO" />

      <div class="md:flex md:items-center md:justify-between md:gap-12 pt-2">
        <p class="font-inter text-encore-dim text-sm md:text-base leading-[1.6] max-w-[440px] m-0">
          Tell me what you're building and where it's stuck. Based in Venice, CA. Working remote.
        </p>
        <a
          href="mailto:hello@cacho.dev"
          class="mt-8 md:mt-0 flex md:inline-flex items-center justify-center bg-encore-accent text-encore-bg font-grotesk font-bold text-sm md:text-base tracking-[1px] px-8 py-4 hover:opacity-90 transition-opacity w-full md:w-auto shrink-0"
        >
          HELLO@CACHO.DEV →
        </a>
      </div>

      <div class="flex flex-col md:flex-row gap-4 md:gap-12 pt-12 md:pt-16 font-smono text-xs tracking-[2px]">
        <a href="https://www.linkedin.com/in/agcacho/" target="_blank" rel="noopener noreferrer" class="text-encore-dim hover:text-encore-fg transition-colors">LINKEDIN / IN/AGCACHO</a>
        <a href="/assets/Resume.pdf" target="_blank" class="text-encore-dim hover:text-encore-fg transition-colors">RESUME ↓</a>
      </div>
    </section>
  </MainLayout>
</html>
