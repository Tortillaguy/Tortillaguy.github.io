---
const isDev = Astro.url.pathname.replace(/\/$/, "") === "/dev";
const nav = isDev
  ? [
      ["OFFERS", "/dev#offers"],
      ["WORK", "/dev#work"],
      ["PROCESS", "/dev#process"],
      ["CONTACT", "/dev#contact"],
    ]
  : [
      ["WORK", "/#engineering"],
      ["ART", "/#art"],
      ["SHOWS", "/#shows"],
      ["ABOUT", "/#about"],
      ["CONTACT", "/#contact"],
    ];
const views = [
  ["WORK", "/", !isDev],
  ["HIRE", "/dev", isDev],
] as const;
---

<header class="flex items-center justify-between gap-4 px-5 md:px-12 h-[52px] md:h-[76px]">
  <div class="flex items-center gap-4 md:gap-6">
    <a href={isDev ? "/dev" : "/#home"} class="font-plex font-semibold text-sm tracking-[2px] text-encore-fg">CACHO.DEV</a>
    <div class="flex border border-encore-line font-plex text-[10px] md:text-xs tracking-[2px]" aria-label="Site view">
      {
        views.map(([label, href, active]) => (
          <a
            href={href}
            aria-current={active ? "page" : undefined}
            class={`px-2 py-1 transition-colors ${active ? "bg-encore-accent text-encore-bg" : "text-encore-dim hover:text-encore-fg"}`}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>
  <nav class="hidden md:flex items-center gap-9">
    {
      nav.map(([label, href]) => (
        <a href={href} class="font-plex text-xs tracking-[2px] text-encore-dim hover:text-encore-fg transition-colors">
          {label}
        </a>
      ))
    }
  </nav>
  <a href={isDev ? "/dev#contact" : "/#contact"} class="md:hidden font-plex text-xs tracking-[2px] text-encore-accent">CONTACT</a>
</header>
