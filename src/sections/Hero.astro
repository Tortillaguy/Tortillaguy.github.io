---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.jpg";
---

<section
  id="home"
  class="relative flex flex-col justify-between h-[calc(100svh-52px)] md:h-[calc(100svh-76px)] min-h-[600px] max-h-[1100px] overflow-hidden"
>
  <Image
    src={heroImage}
    alt="Festival stage under light beams with crowd silhouettes"
    class="absolute inset-0 w-full h-full object-cover"
    widths={[390, 800, 1440, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <video
    id="hero-reel"
    class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  ></video>
  <script is:inline>
    {
      const reel = document.getElementById("hero-reel");
      const portrait = window.matchMedia("(max-width: 639px)");
      const motionOk = window.matchMedia("(prefers-reduced-motion: no-preference)");
      const av1 = reel.canPlayType('video/mp4; codecs="av01.0.08M.08"');
      const apply = () => {
        if (!av1 || !motionOk.matches || navigator.connection?.saveData) return;
        const src = portrait.matches
          ? "/assets/sizzle-portrait.av1.mp4"
          : "/assets/sizzle-wide.av1.mp4";
        if (!reel.src.endsWith(src)) {
          reel.src = src;
          reel.play().catch(() => {});
        }
      };
      apply();
      portrait.addEventListener("change", apply);
      motionOk.addEventListener("change", apply);
      reel.addEventListener(
        "playing",
        () => reel.classList.remove("opacity-0"),
        { once: true },
      );
      new IntersectionObserver(([entry]) => {
        if (!reel.src) return;
        if (entry.isIntersecting) reel.play().catch(() => {});
        else reel.pause();
      }).observe(reel);
    }
  </script>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, rgba(10,10,10,0) 35%, rgba(10,10,10,0.8) 80%, #0A0A0A 100%);"
  >
  </div>

  <div class="relative flex justify-end px-5 py-4 md:px-12 md:py-6 font-plex text-[9px] md:text-xs tracking-[2px] text-encore-fg">
    <span>VENICE, CA</span>
  </div>

  <div class="relative px-5 md:px-12 font-grotesk font-medium leading-[0.95] text-[36px] md:text-[64px]">
    <p class="fringe-sm md:fringe text-encore-fg m-0">LIGHT,</p>
    <p class="fuzzy-sm md:fuzzy text-encore-fg m-0">MOTION,</p>
    <p class="text-encore-accent m-0">&amp; CODE.</p>
  </div>

  <h1 class="relative font-display text-encore-fg leading-[0.82] m-0 px-5 pb-7 text-[96px] sm:hidden">
    ADRIAN<br />CACHO
  </h1>
  <h1 class="relative hidden sm:block font-display text-encore-fg leading-[0.82] m-0 text-center text-[clamp(96px,18vw,265px)] whitespace-nowrap">
    ADRIAN CACHO
  </h1>
</section>
