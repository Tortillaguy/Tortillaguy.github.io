---
import SectionHeader from "../components/SectionHeader.astro";
import { Image } from "astro:assets";
import art from "../data/art";
import artCaseStudies from "../data/artCaseStudies";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*.{webp,jpg,jpeg,png}",
  { eager: true }
);
const img = (filename: string) => images[`../assets/${filename}`]?.default;

// Pick by slug, not by display name: names are copy and do change (two pieces are
// both called "Oblivion"), and a renamed piece would silently vanish from the
// mosaic here because the missing entry gets dropped by .filter(Boolean) below.
const pick = (slug: string) => art.find((p) => p.link === `/art/${slug}`);
// Provenance lines live in artCaseStudies so the card and the case study can't drift apart.
const noteFor = (link: string) =>
  artCaseStudies.find((c) => `/art/${c.slug}` === link)?.mosaicNote;
// Desktop mosaic rows: [wide, narrow], [narrow, wide], [half, half]
const rows = [
  { pieces: [pick("letting-go"), pick("pyro-demo")], cols: "md:grid-cols-[2fr_1fr]", sizes: ["(min-width: 768px) 66vw, 100vw", "(min-width: 768px) 33vw, 100vw"] },
  { pieces: [pick("hardstyle-visuals"), pick("oblivion-v2")], cols: "md:grid-cols-[1fr_2fr]", sizes: ["(min-width: 768px) 33vw, 100vw", "(min-width: 768px) 66vw, 100vw"] },
  { pieces: [pick("light-it-up"), pick("crystals")], cols: "md:grid-cols-2", sizes: ["(min-width: 768px) 50vw, 100vw", "(min-width: 768px) 50vw, 100vw"] },
];
---

<section class="px-5 md:px-12 pt-16 md:pt-28">
  <SectionHeader id="art" index="02" title="ART & MOTION" meta="NOTCH / CINEMA4D / BLENDER" />

  <div class="flex flex-col gap-8 md:gap-9">
    {
      rows.map((row) => (
        <div class={`grid grid-cols-1 gap-8 md:gap-5 ${row.cols}`}>
          {row.pieces.filter(Boolean).map((p, i) => (
            <a href={p.link} class="block group">
              <div class="overflow-hidden border border-encore-line">
                <Image
                  src={img(p.filename)}
                  alt={p.name}
                  class="w-full h-[300px] md:h-[420px] object-cover group-hover:scale-[1.04] transition-transform duration-200 ease-in-out"
                  style={p.imageStyle}
                  widths={[390, 900, 1440]}
                  sizes={row.sizes[i]}
                />
              </div>
              <div class="flex items-center justify-between pt-3">
                <span class="font-grotesk font-bold text-encore-fg group-hover:text-encore-accent transition-colors duration-200 ease-in-out text-sm md:text-base uppercase">{p.name}</span>
                <span class="font-smono text-encore-dim text-[10px] tracking-[1px] uppercase text-right">
                  {(p.tags ?? []).join(" · ")}
                </span>
              </div>
              {noteFor(p.link) && (
                <p class="font-inter text-encore-dim text-xs md:text-sm leading-snug m-0 pt-1.5 max-w-[52ch]">
                  {noteFor(p.link)}
                </p>
              )}
            </a>
          ))}
        </div>
      ))
    }
  </div>
</section>
